---
layout: layouts/base.njk
permalink: /
---

<section class="hero">
  <div class="wrap">
    <p class="eyebrow">{{ site.ciudades | join(" · ") }}</p>
    <h1 class="hero__title">Experiencias<br>que conectan</h1>
    <p class="hero__lead">
      Organizamos eventos empresariales y acciones promocionales.
      Más de 20 años de equipo, coordinación y logística.
    </p>
  </div>
</section>

<section class="section" id="eventos">
  <div class="wrap">
    <h2 class="section__title">Eventos</h2>
  </div>

  <ul class="grid grid--eventos">
    {%- for e in eventos %}
    <li class="tile">
      <img src="/assets/img/eventos/{{ e.img }}.jpg" alt="{{ e.alt }}"
           loading="{% if loop.index <= 4 %}eager{% else %}lazy{% endif %}" decoding="async">
      <span class="tile__label">{{ e.title }}</span>
    </li>
    {%- endfor %}
  </ul>
</section>

{% include "cta.njk" %}
